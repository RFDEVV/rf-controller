// Sumber tunggal daftar parameter. Dibaca firmware (C++) dan aplikasi (Python).
// Format baris: P(nama, bawaan, min, maks)
// Aksi dikemas sebagai tipe*256+kode. Tipe: 0 kosong, 1 keyboard, 2 gamepad, 3 mouse, 4 sistem.

// --- Umum
P(out_mode,0,0,2)
P(tap_ms,40,20,300)
P(failsafe_ms,250,60,2000)

// --- Setir (CH1)
P(inv1,0,0,1)
P(c1_min,1000,500,2600)
P(c1_mid,1500,500,2600)
P(c1_max,2000,500,2600)
P(dz1,3,0,40)
P(ex1,0,0,100)
P(st_limit,100,20,100)

// --- Gas dan rem (CH2)
P(inv2,0,0,1)
P(c2_min,1000,500,2600)
P(c2_mid,1500,500,2600)
P(c2_max,2000,500,2600)
P(dz2,3,0,40)
P(ex2,0,0,100)
P(thr_limit,100,10,100)

